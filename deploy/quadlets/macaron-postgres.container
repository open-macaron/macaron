[Unit]
Description=macaron-bot: Postgres (ledger, runs, pg-boss)

[Container]
ContainerName=macaron-postgres
Image=docker.io/library/postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
# Own user namespace: root in here is an unprivileged, unshared ID on the host.
UserNS=auto
Network=macaron-db.network
Volume=macaron-pgdata.volume:/var/lib/postgresql/data
Environment=POSTGRES_USER=macaron POSTGRES_DB=macaron
Secret=macaron-pg-password,type=env,target=POSTGRES_PASSWORD
ReadOnly=true
NoNewPrivileges=true
HealthCmd=pg_isready -U macaron -d macaron
HealthInterval=10s
HealthStartPeriod=30s
Notify=healthy
LogDriver=journald

[Service]
Restart=on-failure
MemoryMax=768M

[Install]
WantedBy=multi-user.target
