[Unit]
Description=macaron-bot: controller
Requires=macaron-postgres.service
# Bifrost only runs when the upstream LLM key is provisioned; when it does, its admin API must answer first.
After=macaron-postgres.service macaron-bifrost.service

[Container]
ContainerName=macaron-controller
# Digest only. Bumped by a PR whose CI verified the image's build provenance (release.yml on main).
Image=ghcr.io/open-macaron/controller@sha256:0655dca32d35bf8eaefd28a2c08fe653e4998d0f7bb194af1ff0c145ce357f82
UserNS=auto
Network=macaron-edge.network
Network=macaron-db.network
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
# Non-secret settings (PUBLIC_URL, ids, kill switch…). Secrets come from Podman secrets below.
EnvironmentFile=/etc/macaron/controller.env
Environment=NODE_ENV=production CONFIG_DIR=/opt/macaron/config PORT=8080
Volume=/opt/macaron/repo/config:/opt/macaron/config:ro,Z
Secret=macaron-database-url,type=env,target=DATABASE_URL
Secret=macaron-gh-interact,type=env,target=GH_INTERACT
Secret=macaron-gh-push,type=env,target=GH_PUSH
Secret=macaron-gh-org,type=env,target=GH_ORG
# OpenRouter is no longer configured (its keys are disabled; LLM_BACKEND=bifrost). To bring it back,
# mount macaron-or-provisioning and macaron-or-router as OPENROUTER_PROVISIONING_KEY / OPENROUTER_ROUTER_KEY.
Secret=macaron-bifrost-admin,type=env,target=BIFROST_ADMIN_PASSWORD
Secret=macaron-webhook-hmac,type=env,target=WEBHOOK_HMAC
HealthCmd=node -e "fetch('http://127.0.0.1:8080/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
HealthInterval=15s
HealthStartPeriod=60s
Notify=healthy
LogDriver=journald

[Service]
# Migrations, then each LLM backend's start-up checks, before it reports healthy.
TimeoutStartSec=180
Restart=on-failure
RestartSec=10
MemoryMax=768M
# SIGHUP reloads config/ (deploy.sh sends it after pulling new configuration).
ExecReload=/usr/bin/podman kill --signal HUP macaron-controller

[Install]
WantedBy=multi-user.target
