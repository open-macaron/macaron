[Unit]
Description=macaron-bot: Caddy (TLS, only /v1/bootstrap and /v1/webhook are routed)
Wants=macaron-controller.service
After=macaron-controller.service

[Container]
ContainerName=macaron-caddy
Image=docker.io/library/caddy:2@sha256:685ae3d7c34d9b5f8caeddc5d14051db7bbd88ff1f5a2fa0c16bd8ca328fb7af
UserNS=auto
Network=macaron-edge.network
PublishPort=80:80
PublishPort=443:443
ReadOnly=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
EnvironmentFile=/etc/macaron/caddy.env
Volume=macaron-caddy.volume:/data
# Caddy autosaves its config to /config; with the admin API off that's disposable.
Tmpfs=/config
Volume=/opt/macaron/repo/deploy/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
LogDriver=journald

[Service]
Restart=on-failure
MemoryMax=256M

[Install]
WantedBy=multi-user.target
