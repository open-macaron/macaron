# macaron-bot edge. MACARON_HOST comes from /etc/macaron/caddy.env.
{
	# The egress filter only allows TCP 443 out, and UDP 443 isn't published: no HTTP/3.
	servers {
		protocols h1 h2
	}
	admin off
}

{$MACARON_HOST} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# The only routes the internet may reach. Health checks stay inside the host.
	@api path /v1/bootstrap /v1/webhook
	handle @api {
		request_body {
			max_size 26MB
		}
		reverse_proxy macaron-controller:8080
	}

	# Runners' LLM traffic to Bifrost: three exact routes. Each request is rewritten to its canonical
	# upstream path (matching ignores case and cleans the path), so nothing else on Bifrost (admin API,
	# UI, Batch API whose cost is charged after the run's key is gone) is reachable through here.
	@llmMessages {
		path /llm/anthropic/v1/messages
		method POST
	}
	handle @llmMessages {
		request_body {
			max_size 32MB
		}
		rewrite * /anthropic/v1/messages?{query}
		reverse_proxy macaron-bifrost:8080
	}
	@llmCountTokens {
		path /llm/anthropic/v1/messages/count_tokens
		method POST
	}
	handle @llmCountTokens {
		request_body {
			max_size 32MB
		}
		rewrite * /anthropic/v1/messages/count_tokens?{query}
		reverse_proxy macaron-bifrost:8080
	}
	@llmModels {
		path /llm/anthropic/v1/models
		method GET
	}
	handle @llmModels {
		rewrite * /anthropic/v1/models?{query}
		reverse_proxy macaron-bifrost:8080
	}

	handle {
		respond 404
	}
}
