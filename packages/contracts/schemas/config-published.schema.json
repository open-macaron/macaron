{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:global\\.yaml|projects\\/[a-z0-9]+(?:-[a-z0-9]+)*\\/(?:project\\.yaml|repos\\/[A-Za-z0-9._-]{1,100}\\.ya?ml))$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 65536
      }
    }
  },
  "required": [
    "version",
    "commit",
    "files"
  ],
  "additionalProperties": false
}
