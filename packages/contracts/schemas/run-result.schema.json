{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "reply",
        "plan",
        "ask",
        "commit",
        "escalate",
        "noop",
        "review"
      ]
    },
    "escalateTo": {
      "type": "string",
      "enum": [
        "triage",
        "plan",
        "implement",
        "address_review",
        "reproduce",
        "verify",
        "retro",
        "review"
      ]
    },
    "escalateOn": {
      "type": "string",
      "enum": [
        "linux",
        "windows",
        "macos"
      ]
    },
    "commitMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "pr": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "body": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "string",
      "maxLength": 65536
    },
    "replies": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "inReplyTo": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "required": [
          "inReplyTo",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "attachments": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "path": {
            "type": "string",
            "pattern": "^media\\/[A-Za-z0-9._-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "preview": {
            "type": "string",
            "pattern": "^media\\/[A-Za-z0-9._-]+$"
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "caption"
        ],
        "additionalProperties": false
      }
    },
    "learnings": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "global",
              "project",
              "repo"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "scope",
          "topic",
          "text",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "violation",
              "not_applicable"
            ]
          },
          "evidence": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "file",
                "line",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "ruleId",
          "verdict",
          "evidence",
          "explanation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "action",
    "replies",
    "summary",
    "attachments",
    "learnings"
  ],
  "additionalProperties": false
}
