{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "upsert"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "mode": {
                "type": "string",
                "enum": [
                  "100644",
                  "100755"
                ]
              },
              "contentBase64": {
                "type": "string",
                "format": "base64",
                "contentEncoding": "base64",
                "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
              }
            },
            "required": [
              "action",
              "path",
              "mode",
              "contentBase64"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "delete"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "action",
              "path"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "baseSha",
    "files"
  ],
  "additionalProperties": false
}
