# macaron-bot controller image. Build from the repository root:
#   podman build -f packages/controller/Containerfile -t macaron-controller .
# Base images: Red Hat's hardened (Hummingbird) Node.js, pinned by digest; Renovate bumps
# them. Unlike UBI's, they carry the fix for CVE-2026-111497 (Node2Shell): libbrotli 1.2.1.

FROM quay.io/hummingbird/nodejs:24-builder@sha256:bf929d72b583368ec6c6f9cb6ff5a555b96c4bc3ddaf7ad0dcba4c6590085d4e AS build
USER 0
RUN npm install --global --no-fund --no-audit pnpm@12.13.0
WORKDIR /src
# Dependencies first, for layer caching: only manifests and the lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/review/package.json packages/review/
COPY packages/controller/package.json packages/controller/
RUN pnpm install --frozen-lockfile --filter @open-macaron/controller...
COPY packages/contracts packages/contracts
COPY packages/review packages/review
COPY packages/controller packages/controller
RUN pnpm --filter @open-macaron/controller... run build \
 && pnpm --filter @open-macaron/controller deploy --prod --legacy /opt/app

FROM quay.io/hummingbird/nodejs:24@sha256:3fef28300864adffdb5a35bd4523b213f2123c0316cf57bf7f2118cdc288441a
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="macaron-controller" \
      org.opencontainers.image.source="https://github.com/open-macaron/macaron" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
COPY --from=build --chown=65532:0 /opt/app /opt/app
WORKDIR /opt/app
ENV NODE_ENV=production
USER 65532
EXPOSE 8080
CMD ["node", "--enable-source-maps", "dist/main.js"]
