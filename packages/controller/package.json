{
  "name": "@open-macaron/controller",
  "version": "0.4.3",
  "private": true,
  "description": "macaron-bot controller: ingest, routing, run launching, budgets, gate and publishing",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "pnpm build && node --enable-source-maps --env-file=${MACARON_ENV_FILE:-$HOME/.config/macaron/dev.env} dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "gen": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/emit-openapi.js",
    "gen:bifrost": "openapi-ts -f openapi-ts.bifrost.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@octokit/core": "catalog:",
    "@octokit/plugin-retry": "catalog:",
    "@octokit/plugin-throttling": "catalog:",
    "@octokit/rest": "catalog:",
    "@octokit/webhooks": "catalog:",
    "@open-macaron/contracts": "workspace:*",
    "@open-macaron/review": "workspace:*",
    "@openrouter/sdk": "catalog:",
    "@secretlint/core": "catalog:",
    "@secretlint/secretlint-rule-pattern": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@sindresorhus/slugify": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "fflate": "catalog:",
    "file-type": "catalog:",
    "ipaddr.js": "catalog:",
    "jose": "catalog:",
    "markdown-table": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "nestjs-pino": "catalog:",
    "p-retry": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "unist-util-visit": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "catalog:",
    "@nestjs/testing": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/express": "catalog:",
    "@types/mdast": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "msw": "catalog:"
  }
}
