{
  "name": "@open-macaron/controller",
  "version": "0.0.0",
  "private": true,
  "description": "macaron-bot controller: ingest, routing, run launching, budgets, gate and publishing",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "pnpm build && node --enable-source-maps --env-file=${MACARON_ENV_FILE:-$HOME/.config/macaron/dev.env} dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@octokit/core": "catalog:",
    "@octokit/plugin-retry": "catalog:",
    "@octokit/plugin-throttling": "catalog:",
    "@octokit/rest": "catalog:",
    "@octokit/webhooks-methods": "catalog:",
    "@open-macaron/contracts": "workspace:*",
    "@openrouter/sdk": "catalog:",
    "drizzle-orm": "catalog:",
    "fflate": "catalog:",
    "jose": "catalog:",
    "nestjs-pino": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "msw": "catalog:"
  }
}
