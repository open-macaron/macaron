# macaron-bot controller — every variable it reads (validated at boot by src/config/env.ts).
#
# Local experiments: copy to ~/.config/macaron/dev.env (outside the repo), `chmod 600` it,
# fill in the secrets yourself, then `pnpm --filter @open-macaron/controller dev`.
# On the VPS: non-secret values go in ~/.config/macaron/controller.env, secrets are Podman
# secrets (docs/DEPLOYMENT.md §4). Never commit a filled-in copy.

# --- Service -------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
PORT=8080
# Public HTTPS base URL (Caddy). Also the OIDC audience runners request: must match exactly.
PUBLIC_URL=https://macaron.example.org
# Local: podman run -d --name macaron-pg -e POSTGRES_USER=macaron -e POSTGRES_PASSWORD=macaron -e POSTGRES_DB=macaron -p 5432:5432 docker.io/library/postgres:17-alpine
DATABASE_URL=postgres://macaron:macaron@localhost:5432/macaron
# Directory with global.yaml and projects/ (relative to packages/controller when running locally).
CONFIG_DIR=../../config
# Kill switch: false = ingest nothing, revoke open keys.
MACARON_ENABLED=true
# Optional: only these GitHub user ids (comma-separated, not logins) may trigger the bot,
# on top of config/. Unset = no restriction.
# MACARON_ALLOWED_USER_IDS=42176370

# --- GitHub (all three are tokens of the macaron-bot account; docs/REPOSITORIES.md §3) -----
GITHUB_BOT_LOGIN=macaron-bot
# Classic PAT, scopes: public_repo, notifications. Comments, reactions, PRs, notifications.
GH_INTERACT=
# Fine-grained PAT, resource owner macaron-bot, all repositories, Contents: read and write.
GH_PUSH=
# Fine-grained PAT, resource owner open-macaron, repository open-macaron/runner only,
# Actions: read and write. Starts and cancels runs; nothing else.
GH_ORG=

# --- Runner repository (immutable ids pinned in the OIDC check) ----------------------------
RUNNER_REPO=open-macaron/runner
# gh api repos/open-macaron/runner --jq .id   (create the repository first)
RUNNER_REPO_ID=1420757156
# gh api orgs/open-macaron --jq .id
RUNNER_OWNER_ID=342991704
RUNNER_WORKFLOW=run.yml
# open-macaron/knowledge's read API (GitHub Pages)
KNOWLEDGE_URL=https://open-macaron.github.io/knowledge/v1

# --- LLM keys ------------------------------------------------------------------------------
# Where new runs get their key: bifrost (production) or openrouter. A backend whose variables are
# set stays usable for the runs minted on it before a switch; if it isn't the active one and fails
# its start-up check, it is left out.
LLM_BACKEND=bifrost

# --- Bifrost (virtual keys over the upstream LLM key) -----------------------------------
# Admin API, internal network only (never routed by Caddy). Locally: deploy/bifrost/dev.sh up.
BIFROST_ADMIN_URL=http://127.0.0.1:18080
# What runners use as ANTHROPIC_BASE_URL: Caddy's inference-only route.
BIFROST_PUBLIC_URL=https://localhost:18443/llm/anthropic
BIFROST_ADMIN_USERNAME=macaron
BIFROST_ADMIN_PASSWORD=
# Requests per minute a run's key may start (bounds overshoot past its budget).
# BIFROST_REQUESTS_PER_MINUTE=60
# The upstream's URL and key are Bifrost's, not the controller's: provision-secrets.sh and dev.sh
# read LLM_UPSTREAM_URL and LLM_UPSTREAM_KEY from this file.
# LLM_UPSTREAM_URL=
# LLM_UPSTREAM_KEY=

# --- OpenRouter (optional, not configured in production) ------------------------------------
# Workspace (slug) every run key is created in: its dashboard is the bot's total spend.
# OPENROUTER_WORKSPACE=macaron
# Management (provisioning) key: creates one capped, expiring key per run. Never leaves the controller.
# OPENROUTER_PROVISIONING_KEY=
# Regular key with a small daily limit, for the planned Router's single classification call.
# OPENROUTER_ROUTER_KEY=

# --- Webhooks ------------------------------------------------------------------------------
# Shared secret of open-macaron/runner's workflow_run webhook: openssl rand -hex 32
WEBHOOK_HMAC=
