# macaron web app image. Build from the repository root:
#   podman build -f packages/web/Containerfile -t macaron-web .
# Base images: Red Hat's hardened (Hummingbird) Node.js, pinned by digest (the controller's); Renovate bumps
# them. Unlike UBI's, they carry the fix for CVE-2026-111497 (Node2Shell): libbrotli 1.2.1.

FROM quay.io/hummingbird/nodejs:24-builder@sha256:03d02a4ae12e0de51b33fe3233ae35aff07d8d3bb4cef6293c4442e553b917fd AS build
USER 0
RUN npm install --global --no-fund --no-audit pnpm@12.13.0
WORKDIR /src
# Dependencies first, for layer caching: only manifests and the lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/web/package.json packages/web/
RUN pnpm install --frozen-lockfile --filter @open-macaron/web...
# Contracts are bundled from their TypeScript sources (the @open-macaron/source condition): no build.
COPY packages/contracts packages/contracts
COPY packages/web packages/web
# adapter-node bundles every dependency into build/: the runtime image needs no node_modules.
RUN pnpm --filter @open-macaron/web build

FROM quay.io/hummingbird/nodejs:24@sha256:c9640ede7ee86932dfbbbef53a123bcb6c96f0ef51244d38805e426568f9826b
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="macaron-web" \
      org.opencontainers.image.source="https://github.com/open-macaron/macaron" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
COPY --from=build --chown=65532:0 /src/packages/web/build /opt/app/build
COPY --from=build --chown=65532:0 /src/packages/web/package.json /opt/app/package.json
WORKDIR /opt/app
ENV NODE_ENV=production \
    PORT=8080 \
    HOST=0.0.0.0
USER 65532
EXPOSE 8080
CMD ["node", "build/index.js"]
